,"sizes":"(min-width: 768px) 768px, 100vw"},"sources":[{"srcSet":"/static/1f220406639f36bb2eeea3e9dcdeb178/b3234/javascript-intl-api-i18n-guide.webp 192w,\n/static/1f220406639f36bb2eeea3e9dcdeb178/65a7c/javascript-intl-api-i18n-guide.webp 384w,\n/static/1f220406639f36bb2eeea3e9dcdeb178/30053/javascript-intl-api-i18n-guide.webp 768w,\n/static/1f220406639f36bb2eeea3e9dcdeb178/87027/javascript-intl-api-i18n-guide.webp 1536w","type":"image/webp","sizes":"(min-width: 768px) 768px, 100vw"}]},"width":768,"height":400}}}}}},{"node":{"id":"ec86c788-dff4-57c3-b385-76c83c50a65d","fields":{"slug":"/javascript_libraries_full_guide/"},"frontmatter":{"title":"JavaScript에서 자주 사용되는 유용하고 유명한 외부 라이브러리 완벽 가이드","summary":"현대 웹 개발 필수 도구부터 전문가들이 사용하는 고급 유틸리티까지","date":"2025.11.19.","categories":["javascript"],"thumbnail":{"childImageSharp":{"gatsbyImageData":{"layout":"constrained","placeholder":{"fallback":"data:image/png;base64,"},"images":{"fallback":{"src":"/static/326284e8056d47ba5b087d0a47ddaa6e/473b7/jslib.png","srcSet":"/static/326284e8056d47ba5b087d0a47ddaa6e/be4d9/jslib.png 192w,\n/static/326284e8056d47ba5b087d0a47ddaa6e/5fc50/jslib.png 384w,\n/static/326284e8056d47ba5b087d0a47ddaa6e/473b7/jslib.png 768w,\n/static/326284e8056d47ba5b087d0a47ddaa6e/13e83/jslib.png 1536w","sizes":"(min-width: 768px) 768px, 100vw"},"sources":[{"srcSet":"/static/326284e8056d47ba5b087d0a47ddaa6e/b3234/jslib.webp 192w,\n/static/326284e8056d47ba5b087d0a47ddaa6e/65a7c/jslib.webp 384w,\n/static/326284e8056d47ba5b087d0a47ddaa6e/30053/jslib.webp 768w,\n/static/326284e8056d47ba5b087d0a47ddaa6e/87027/jslib.webp 1536w","type":"image/webp","sizes":"(min-width: 768px) 768px, 100vw"}]},"width":768,"height":400}}}}}},{"node":{"id":"47911708-3283-5c47-b0d9-71b6e0606611","fields":{"slug":"/js-modern-techniques-and-architecture/"},"frontmatter":{"title":"자바스크립트로 만드는 진짜 서비스","summary":"고급 기술과 아키텍처 이야기","date":"2025.07.25.","categories":["JavaScript","Web"],"thumbnail":{"childImageSharp":{"gatsbyImageData":{"layout":"constrained","placeholder":{"fallback":"data:image/png;base64,"},"images":{"fallback":{"src":"/static/6c274967b931bb7b98522ffd85842ad3/473b7/JavaScript.png","srcSet":"/static/6c274967b931bb7b98522ffd85842ad3/be4d9/JavaScript.png 192w,\n/static/6c274967b931bb7b98522ffd85842ad3/5fc50/JavaScript.png 384w,\n/static/6c274967b931bb7b98522ffd85842ad3/473b7/JavaScript.png 768w,\n/static/6c274967b931bb7b98522ffd85842ad3/13e83/JavaScript.png 1536w","sizes":"(min-width: 768px) 768px, 100vw"},"sources":[{"srcSet":"/static/6c274967b931bb7b98522ffd85842ad3/b3234/JavaScript.webp 192w,\n/static/6c274967b931bb7b98522ffd85842ad3/65a7c/JavaScript.webp 384w,\n/static/6c274967b931bb7b98522ffd85842ad3/30053/JavaScript.webp 768w,\n/static/6c274967b931bb7b98522ffd85842ad3/87027/JavaScript.webp 1536w","type":"image/webp","sizes":"(min-width: 768px) 768px, 100vw"}]},"width":768,"height":400}}}}}}]},"siteStats":{"available":true,"posts":[{"path":"/navigation-api-spa-routing-guide/","views":4},{"path":"/gatsby/","views":3},{"path":"/compute-pressure-api-guide/","views":2},{"path":"/popover-api-and-top-layer-guide/","views":2},{"path":"/cloud-tech-overview/","views":1},{"path":"/frontend-observability-opentelemetry-rum/","views":1},{"path":"/islands-architecture-astro-guide/","views":1},{"path":"/supabase_guide/","views":1},{"path":"/vercel/","views":1},{"path":"/view-transitions-api-guide/","views":1},{"path":"/web-audio-api-guide/","views":1},{"path":"/web-bluetooth-and-hid-api-guide/","views":1},{"path":"/web-bluetooth-api-guide/","views":1},{"path":"/web-identity-credential-manager-api-guide/","views":1},{"path":"/web-locks-api-concurrency-control/","views":1},{"path":"/webcodecs-api-guide/","views":1}]}},"pageContext":{"slug":"/2026_web_trend (1)/","relatedSlugs":["/javascript-intl-api-i18n-guide/","/javascript_libraries_full_guide/","/js-modern-techniques-and-architecture/","/how-js-works-after-html-loaded/"]}},"staticQueryHashes":["766300711"],"slicesMap":{}}