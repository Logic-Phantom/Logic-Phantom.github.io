ype":"image/webp","sizes":"(min-width: 768px) 768px, 100vw"}]},"width":768,"height":400}}}}}},{"node":{"id":"6abc5a93-a7d2-541f-ac90-1363239090cf","fields":{"slug":"/ai_editors_tools/"},"frontmatter":{"title":"🚀 요즘 개발자들에게 잘나가는 AI 에디터 & 툴 총정리","summary":"잘나가는 것중 잘나가","date":"2025.09.08.","categories":["Web","AI"],"thumbnail":{"childImageSharp":{"gatsbyImageData":{"layout":"constrained","placeholder":{"fallback":"data:image/png;base64,"},"images":{"fallback":{"src":"/static/53c844fd3ce3d0d24cd565e734cdbea4/473b7/AIEditors.png","srcSet":"/static/53c844fd3ce3d0d24cd565e734cdbea4/be4d9/AIEditors.png 192w,\n/static/53c844fd3ce3d0d24cd565e734cdbea4/5fc50/AIEditors.png 384w,\n/static/53c844fd3ce3d0d24cd565e734cdbea4/473b7/AIEditors.png 768w,\n/static/53c844fd3ce3d0d24cd565e734cdbea4/13e83/AIEditors.png 1536w","sizes":"(min-width: 768px) 768px, 100vw"},"sources":[{"srcSet":"/static/53c844fd3ce3d0d24cd565e734cdbea4/b3234/AIEditors.webp 192w,\n/static/53c844fd3ce3d0d24cd565e734cdbea4/65a7c/AIEditors.webp 384w,\n/static/53c844fd3ce3d0d24cd565e734cdbea4/30053/AIEditors.webp 768w,\n/static/53c844fd3ce3d0d24cd565e734cdbea4/87027/AIEditors.webp 1536w","type":"image/webp","sizes":"(min-width: 768px) 768px, 100vw"}]},"width":768,"height":400}}}}}}]},"siteStats":{"available":true,"posts":[{"path":"/navigation-api-spa-routing-guide/","views":3},{"path":"/islands-architecture-astro-guide/","views":1},{"path":"/popover-api-and-top-layer-guide/","views":1},{"path":"/view-transitions-api-guide/","views":1},{"path":"/web-audio-api-guide/","views":1},{"path":"/web-bluetooth-api-guide/","views":1},{"path":"/webcodecs-api-guide/","views":1}]}},"pageContext":{"slug":"/ai-coding-assistants/","relatedSlugs":["/ai-code-assistant-guide/","/ai_editors_tools/","/ai-era-fe-be-what-to-prepare-2025/","/ai-governance/"]}},"staticQueryHashes":["766300711"],"slicesMap":{}}