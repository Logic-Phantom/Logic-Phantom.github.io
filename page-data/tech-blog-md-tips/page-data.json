px, 100vw"},"sources":[{"srcSet":"/static/4c1ed83c32a5750186d5f3a5c9bae9e1/b3234/signals-based-reactivity-guide.webp 192w,\n/static/4c1ed83c32a5750186d5f3a5c9bae9e1/65a7c/signals-based-reactivity-guide.webp 384w,\n/static/4c1ed83c32a5750186d5f3a5c9bae9e1/30053/signals-based-reactivity-guide.webp 768w,\n/static/4c1ed83c32a5750186d5f3a5c9bae9e1/87027/signals-based-reactivity-guide.webp 1536w","type":"image/webp","sizes":"(min-width: 768px) 768px, 100vw"}]},"width":768,"height":400}}}}}}]},"siteStats":{"available":true,"posts":[{"path":"/navigation-api-spa-routing-guide/","views":4},{"path":"/compute-pressure-api-guide/","views":2},{"path":"/gatsby/","views":2},{"path":"/popover-api-and-top-layer-guide/","views":2},{"path":"/cloud-tech-overview/","views":1},{"path":"/frontend-observability-opentelemetry-rum/","views":1},{"path":"/islands-architecture-astro-guide/","views":1},{"path":"/supabase_guide/","views":1},{"path":"/vercel/","views":1},{"path":"/view-transitions-api-guide/","views":1},{"path":"/web-audio-api-guide/","views":1},{"path":"/web-bluetooth-and-hid-api-guide/","views":1},{"path":"/web-bluetooth-api-guide/","views":1},{"path":"/web-identity-credential-manager-api-guide/","views":1},{"path":"/web-locks-api-concurrency-control/","views":1},{"path":"/webcodecs-api-guide/","views":1}]}},"pageContext":{"slug":"/tech-blog-md-tips/","relatedSlugs":["/islands-architecture-astro-guide/","/service-worker-caching-deep-dive/","/feature-flag-and-gradual-rollout-guide/","/signals-based-reactivity-guide/"]}},"staticQueryHashes":["766300711"],"slicesMap":{}}