b7/spa-mpa2.png","srcSet":"/static/489e640273bbb84427827a8609b9c60d/be4d9/spa-mpa2.png 192w,\n/static/489e640273bbb84427827a8609b9c60d/5fc50/spa-mpa2.png 384w,\n/static/489e640273bbb84427827a8609b9c60d/473b7/spa-mpa2.png 768w,\n/static/489e640273bbb84427827a8609b9c60d/13e83/spa-mpa2.png 1536w","sizes":"(min-width: 768px) 768px, 100vw"},"sources":[{"srcSet":"/static/489e640273bbb84427827a8609b9c60d/b3234/spa-mpa2.webp 192w,\n/static/489e640273bbb84427827a8609b9c60d/65a7c/spa-mpa2.webp 384w,\n/static/489e640273bbb84427827a8609b9c60d/30053/spa-mpa2.webp 768w,\n/static/489e640273bbb84427827a8609b9c60d/87027/spa-mpa2.webp 1536w","type":"image/webp","sizes":"(min-width: 768px) 768px, 100vw"}]},"width":768,"height":400}}}}}},{"node":{"id":"b7a894a5-8c0a-5383-9e94-6d3bd7bbf778","fields":{"slug":"/vercel/"},"frontmatter":{"title":"Vercel: 현대적인 웹 배포 플랫폼","summary":"Vercel의 특징과 장점, 그리고 실제 배포 방법","date":"2024.11.20.","categories":["CI/CD"],"thumbnail":{"childImageSharp":{"gatsbyImageData":{"layout":"constrained","placeholder":{"fallback":"data:image/png;base64,"},"images":{"fallback":{"src":"/static/691900156b448fdaac0dec26880b5da8/473b7/vercel.png","srcSet":"/static/691900156b448fdaac0dec26880b5da8/be4d9/vercel.png 192w,\n/static/691900156b448fdaac0dec26880b5da8/5fc50/vercel.png 384w,\n/static/691900156b448fdaac0dec26880b5da8/473b7/vercel.png 768w","sizes":"(min-width: 768px) 768px, 100vw"},"sources":[{"srcSet":"/static/691900156b448fdaac0dec26880b5da8/b3234/vercel.webp 192w,\n/static/691900156b448fdaac0dec26880b5da8/65a7c/vercel.webp 384w,\n/static/691900156b448fdaac0dec26880b5da8/30053/vercel.webp 768w","type":"image/webp","sizes":"(min-width: 768px) 768px, 100vw"}]},"width":768,"height":400}}}}}}]},"siteStats":{"available":true,"posts":[{"path":"/navigation-api-spa-routing-guide/","views":3},{"path":"/islands-architecture-astro-guide/","views":1},{"path":"/popover-api-and-top-layer-guide/","views":1},{"path":"/view-transitions-api-guide/","views":1},{"path":"/web-audio-api-