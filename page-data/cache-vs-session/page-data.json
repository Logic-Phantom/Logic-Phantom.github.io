rcSet":"/static/f568a69be9409776010a44fe7d2ec3ce/be4d9/web-bluetooth-and-hid-api-guide.png 192w,\n/static/f568a69be9409776010a44fe7d2ec3ce/5fc50/web-bluetooth-and-hid-api-guide.png 384w,\n/static/f568a69be9409776010a44fe7d2ec3ce/473b7/web-bluetooth-and-hid-api-guide.png 768w,\n/static/f568a69be9409776010a44fe7d2ec3ce/13e83/web-bluetooth-and-hid-api-guide.png 1536w","sizes":"(min-width: 768px) 768px, 100vw"},"sources":[{"srcSet":"/static/f568a69be9409776010a44fe7d2ec3ce/b3234/web-bluetooth-and-hid-api-guide.webp 192w,\n/static/f568a69be9409776010a44fe7d2ec3ce/65a7c/web-bluetooth-and-hid-api-guide.webp 384w,\n/static/f568a69be9409776010a44fe7d2ec3ce/30053/web-bluetooth-and-hid-api-guide.webp 768w,\n/static/f568a69be9409776010a44fe7d2ec3ce/87027/web-bluetooth-and-hid-api-guide.webp 1536w","type":"image/webp","sizes":"(min-width: 768px) 768px, 100vw"}]},"width":768,"height":400}}}}}}]},"siteStats":{"available":true,"posts":[{"path":"/navigation-api-spa-routing-guide/","views":6},{"path":"/popover-api-and-top-layer-guide/","views":5},{"path":"/compute-pressure-api-guide/","views":3},{"path":"/gatsby/","views":3},{"path":"/background-sync-api-guide/","views":2},{"path":"/cookie-store-api-guide/","views":2},{"path":"/web-hid-api-guide/","views":2},{"path":"/web-identity-credential-manager-api-guide/","views":2},{"path":"/2026_web_trend (1)/","views":1},{"path":"/badging-api-guide/","views":1},{"path":"/cloud-tech-overview/","views":1},{"path":"/frontend-observability-opentelemetry-rum/","views":1},{"path":"/idle-detection-api-guide/","views":1},{"path":"/islands-architecture-astro-guide/","views":1},{"path":"/js-modern-techniques-and-architecture/","views":1},{"path":"/media-session-api-guide/","views":1},{"path":"/page-lifecycle-api-guide/","views":1},{"path":"/prioritized-task-scheduling-posttask-guide/","views":1},{"path":"/storage-access-api-guide/","views":1},{"path":"/supabase_guide/","views":1},{"path":"/vercel/","views":1},{"path":"/view-transitions-api-guide/","views":1},{"path":"/virtual-keyboard-api-guide/","views":1},{"path":"/web-audio-api-guide/","views":1},{"path":"/web-bluetooth-and-hid-api-guide/","views":1},{"path":"/web-bluetooth-api-guide/","views":1},{"path":"/web-locks-api-concurrency-control/","views":1},{"path":"/web-nfc-api-guide/","views":1},{"path":"/web-share-target-api-guide/","views":1},{"path":"/web-speech-api-guide/","views":1},{"path":"/webcodecs-api-guide/","views":1}]}},"pageContext":{"slug":"/cache-vs-session/","relatedSlugs":["/screen-details-api-guide/","/client-hints-api-guide/","/document-picture-in-picture-api-guide/","/web-bluetooth-and-hid-api-guide/"]}},"staticQueryHashes":["766300711"],"slicesMap":{}}