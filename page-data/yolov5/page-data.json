384w,\n/static/c6b09241cb63fe9a3f0b450fa75e991a/473b7/coding-assistant2.png 768w","sizes":"(min-width: 768px) 768px, 100vw"},"sources":[{"srcSet":"/static/c6b09241cb63fe9a3f0b450fa75e991a/b3234/coding-assistant2.webp 192w,\n/static/c6b09241cb63fe9a3f0b450fa75e991a/65a7c/coding-assistant2.webp 384w,\n/static/c6b09241cb63fe9a3f0b450fa75e991a/30053/coding-assistant2.webp 768w","type":"image/webp","sizes":"(min-width: 768px) 768px, 100vw"}]},"width":768,"height":400}}}}}},{"node":{"id":"f2ce4713-e4d6-541d-af24-d9025a93f50e","fields":{"slug":"/ai-era-fe-be-what-to-prepare-2025/"},"frontmatter":{"title":"AI 시대, 프론트엔드 & 백엔드 개발자가 지금 준비해야 할 것들","summary":"AI 시대에 경쟁력을 높이기 위해 준비해야 할 역량","date":"2025.08.14.","categories":["AI","Web"],"thumbnail":{"childImageSharp":{"gatsbyImageData":{"layout":"constrained","placeholder":{"fallback":"data:image/png;base64,"},"images":{"fallback":{"src":"/static/13857431c710b207b8867cb031f55431/473b7/AIready.png","srcSet":"/static/13857431c710b207b8867cb031f55431/be4d9/AIready.png 192w,\n/static/13857431c710b207b8867cb031f55431/5fc50/AIready.png 384w,\n/static/13857431c710b207b8867cb031f55431/473b7/AIready.png 768w,\n/static/13857431c710b207b8867cb031f55431/13e83/AIready.png 1536w","sizes":"(min-width: 768px) 768px, 100vw"},"sources":[{"srcSet":"/static/13857431c710b207b8867cb031f55431/b3234/AIready.webp 192w,\n/static/13857431c710b207b8867cb031f55431/65a7c/AIready.webp 384w,\n/static/13857431c710b207b8867cb031f55431/30053/AIready.webp 768w,\n/static/13857431c710b207b8867cb031f55431/87027/AIready.webp 1536w","type":"image/webp","sizes":"(min-width: 768px) 768px, 100vw"}]},"width":768,"height":400}}}}}},{"node":{"id":"6abc5a93-a7d2-541f-ac90-1363239090cf","fields":{"slug":"/ai_editors_tools/"},"frontmatter":{"title":"🚀 요즘 개발자들에게 잘나가는 AI 에디터 & 툴 총정리","summary":"잘나가는 것중 잘나가","date":"2025.09.08.","categories":["Web","AI"],"thumbnail":{"childImageSharp":{"gatsbyImageData":{"layout":"constrained","placeholder":{"fallback":"data:image/png;base64,"},"images":{"fallback":{"src":"/static/53c844fd3ce3d0d24cd565e734cdbea4/473b7/AIEditors.png","srcSet":"/static/53c844fd3ce3d0d24cd565e734cdbea4/be4d9/AIEditors.png 192w,\n/static/53c844fd3ce3d0d24cd565e734cdbea4/5fc50/AIEditors.png 384w,\n/static/53c844fd3ce3d0d24cd565e734cdbea4/473b7/AIEditors.png 768w,\n/static/53c844fd3ce3d0d24cd565e734cdbea4/13e83/AIEditors.png 1536w","sizes":"(min-width: 768px) 768px, 100vw"},"sources":[{"srcSet":"/static/53c844fd3ce3d0d24cd565e734cdbea4/b3234/AIEditors.webp 192w,\n/static/53c844fd3ce3d0d24cd565e734cdbea4/65a7c/AIEditors.webp 384w,\n/static/53c844fd3ce3d0d24cd565e734cdbea4/30053/AIEditors.webp 768w,\n/static/53c844fd3ce3d0d24cd565e734cdbea4/87027/AIEditors.webp 1536w","type":"image/webp","sizes":"(min-width: 768px) 768px, 100vw"}]},"width":768,"height":400}}}}}}]},"siteStats":{"available":true,"posts":[{"path":"/navigation-api-spa-routing-guide/","views":4},{"path":"/gatsby/","views":3},{"path":"/compute-pressure-api-guide/","views":2},{"path":"/popover-api-and-top-layer-guide/","views":2},{"path":"/web-identity-credential-manager-api-guide/","views":2},{"path":"/cloud-tech-overview/","views":1},{"path":"/frontend-observability-opentelemetry-rum/","views":1},{"path":"/islands-architecture-astro-guide/","views":1},{"path":"/supabase_guide/","views":1},{"path":"/vercel/","views":1},{"path":"/view-transitions-api-guide/","views":1},{"path":"/web-audio-api-guide/","views":1},{"path":"/web-bluetooth-and-hid-api-guide/","views":1},{"path":"/web-bluetooth-api-guide/","views":1},{"path":"/web-locks-api-concurrency-control/","views":1},{"path":"/web-share-target-api-guide/","views":1},{"path":"/webcodecs-api-guide/","views":1}]}},"pageContext":{"slug":"/yolov5/","relatedSlugs":["/ai-code-assistant-guide/","/ai-coding-assistants/","/ai_editors_tools/","/ai-era-fe-be-what-to-prepare-2025/"]}},"staticQueryHashes":["766300711"],"slicesMap":{}}