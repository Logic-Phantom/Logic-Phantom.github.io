0vw"}]},"width":768,"height":400}}}}}},{"node":{"id":"04b03588-68f6-52db-81cc-a42ba2d2109f","fields":{"slug":"/javascript-intl-api-i18n-guide/"},"frontmatter":{"title":"🌍 국제화(i18n)와 JavaScript Intl API 완벽 가이드","summary":"무거운 번들 없이 브라우저 내장 API로 끝내는 완벽한 웹 국제화","date":"2026.10.09.","categories":["Web","JavaScript"],"thumbnail":{"childImageSharp":{"gatsbyImageData":{"layout":"constrained","placeholder":{"fallback":"data:image/png;base64,"},"images":{"fallback":{"src":"/static/1f220406639f36bb2eeea3e9dcdeb178/473b7/javascript-intl-api-i18n-guide.png","srcSet":"/static/1f220406639f36bb2eeea3e9dcdeb178/be4d9/javascript-intl-api-i18n-guide.png 192w,\n/static/1f220406639f36bb2eeea3e9dcdeb178/5fc50/javascript-intl-api-i18n-guide.png 384w,\n/static/1f220406639f36bb2eeea3e9dcdeb178/473b7/javascript-intl-api-i18n-guide.png 768w,\n/static/1f220406639f36bb2eeea3e9dcdeb178/13e83/javascript-intl-api-i18n-guide.png 1536w","sizes":"(min-width: 768px) 768px, 100vw"},"sources":[{"srcSet":"/static/1f220406639f36bb2eeea3e9dcdeb178/b3234/javascript-intl-api-i18n-guide.webp 192w,\n/static/1f220406639f36bb2eeea3e9dcdeb178/65a7c/javascript-intl-api-i18n-guide.webp 384w,\n/static/1f220406639f36bb2eeea3e9dcdeb178/30053/javascript-intl-api-i18n-guide.webp 768w,\n/static/1f220406639f36bb2eeea3e9dcdeb178/87027/javascript-intl-api-i18n-guide.webp 1536w","type":"image/webp","sizes":"(min-width: 768px) 768px, 100vw"}]},"width":768,"height":400}}}}}}]},"siteStats":{"available":true,"posts":[{"path":"/web-bluetooth-api-guide/","views":1}]}},"pageContext":{"slug":"/js-modern-techniques-and-architecture/","relatedSlugs":["/javascript-intl-api-i18n-guide/","/how-js-works-after-html-loaded/","/JavaScript_ES5_Advanced/","/islands-architecture-astro-guide/"]}},"staticQueryHashes":["766300711"],"slicesMap":{}}