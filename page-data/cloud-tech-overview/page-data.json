ng;base64,"},"images":{"fallback":{"src":"/static/401383d6518e74015a765c59b566363e/473b7/codeTest.png","srcSet":"/static/401383d6518e74015a765c59b566363e/be4d9/codeTest.png 192w,\n/static/401383d6518e74015a765c59b566363e/5fc50/codeTest.png 384w,\n/static/401383d6518e74015a765c59b566363e/473b7/codeTest.png 768w,\n/static/401383d6518e74015a765c59b566363e/13e83/codeTest.png 1536w","sizes":"(min-width: 768px) 768px, 100vw"},"sources":[{"srcSet":"/static/401383d6518e74015a765c59b566363e/b3234/codeTest.webp 192w,\n/static/401383d6518e74015a765c59b566363e/65a7c/codeTest.webp 384w,\n/static/401383d6518e74015a765c59b566363e/30053/codeTest.webp 768w,\n/static/401383d6518e74015a765c59b566363e/87027/codeTest.webp 1536w","type":"image/webp","sizes":"(min-width: 768px) 768px, 100vw"}]},"width":768,"height":400}}}}}}]},"siteStats":{"available":true,"posts":[{"path":"/navigation-api-spa-routing-guide/","views":4},{"path":"/gatsby/","views":3},{"path":"/compute-pressure-api-guide/","views":2},{"path":"/popover-api-and-top-layer-guide/","views":2},{"path":"/web-identity-credential-manager-api-guide/","views":2},{"path":"/cloud-tech-overview/","views":1},{"path":"/frontend-observability-opentelemetry-rum/","views":1},{"path":"/islands-architecture-astro-guide/","views":1},{"path":"/prioritized-task-scheduling-posttask-guide/","views":1},{"path":"/supabase_guide/","views":1},{"path":"/vercel/","views":1},{"path":"/view-transitions-api-guide/","views":1},{"path":"/web-audio-api-guide/","views":1},{"path":"/web-bluetooth-and-hid-api-guide/","views":1},{"path":"/web-bluetooth-api-guide/","views":1},{"path":"/web-locks-api-concurrency-control/","views":1},{"path":"/web-share-target-api-guide/","views":1},{"path":"/webcodecs-api-guide/","views":1}]}},"pageContext":{"slug":"/cloud-tech-overview/","relatedSlugs":["/webdev-codingtest-guide/","/2026-web-trends/","/web_tips/","/Monolith/"]}},"staticQueryHashes":["766300711"],"slicesMap":{}}