ry":"웹 풀스택 개발자의 여정과 로드맵","date":"2025.07.22.","categories":["UI","Web"],"thumbnail":{"childImageSharp":{"gatsbyImageData":{"layout":"constrained","placeholder":{"fallback":"data:image/png;base64,"},"images":{"fallback":{"src":"/static/85909e36eb3d4b7d35d4c81cd39c7bce/473b7/webUI.png","srcSet":"/static/85909e36eb3d4b7d35d4c81cd39c7bce/be4d9/webUI.png 192w,\n/static/85909e36eb3d4b7d35d4c81cd39c7bce/5fc50/webUI.png 384w,\n/static/85909e36eb3d4b7d35d4c81cd39c7bce/473b7/webUI.png 768w","sizes":"(min-width: 768px) 768px, 100vw"},"sources":[{"srcSet":"/static/85909e36eb3d4b7d35d4c81cd39c7bce/b3234/webUI.webp 192w,\n/static/85909e36eb3d4b7d35d4c81cd39c7bce/65a7c/webUI.webp 384w,\n/static/85909e36eb3d4b7d35d4c81cd39c7bce/30053/webUI.webp 768w","type":"image/webp","sizes":"(min-width: 768px) 768px, 100vw"}]},"width":768,"height":400}}}}}},{"node":{"id":"70b965fd-c100-5cc1-85e8-65711ec0be5d","fields":{"slug":"/popover-api-and-top-layer-guide/"},"frontmatter":{"title":"🎈 Popover API와 최상위 레이어(Top Layer) 완벽 가이드: z-index 지옥과 모달 라이브러리의 종말","summary":"z-index 99999와 모달 라이브러리의 종말","date":"2026.10.18.","categories":["Web"],"thumbnail":{"childImageSharp":{"gatsbyImageData":{"layout":"constrained","placeholder":{"fallback":"data:image/png;base64,"},"images":{"fallback":{"src":"/static/2c9287648b189ddb04707648c182a811/473b7/popover-api-and-top-layer-guide.png","srcSet":"/static/2c9287648b189ddb04707648c182a811/be4d9/popover-api-and-top-layer-guide.png 192w,\n/static/2c9287648b189ddb04707648c182a811/5fc50/popover-api-and-top-layer-guide.png 384w,\n/static/2c9287648b189ddb04707648c182a811/473b7/popover-api-and-top-layer-guide.png 768w,\n/static/2c9287648b189ddb04707648c182a811/13e83/popover-api-and-top-layer-guide.png 1536w","sizes":"(min-width: 768px) 768px, 100vw"},"sources":[{"srcSet":"/static/2c9287648b189ddb04707648c182a811/b3234/popover-api-and-top-layer-guide.webp 192w,\n/static/2c9287648b189ddb04707648c182a811/65a7c/popover-api-and-top-layer-guide.webp 384w,\n/static/2c9287648b189d