idth":768,"height":400}}}}}},{"node":{"id":"efe311d3-26f1-5dbc-b203-062a9cde9ad4","fields":{"slug":"/web-deployment-architecture/"},"frontmatter":{"title":"웹 서비스 배포 흐름 이해하기","summary":"웹서버, WAS, DB까지","date":"2025.07.02.","categories":["CI/CD"],"thumbnail":{"childImageSharp":{"gatsbyImageData":{"layout":"constrained","placeholder":{"fallback":"data:image/png;base64,"},"images":{"fallback":{"src":"/static/71a6a0ae20616d60ccf3ee5e19074125/473b7/CI.png","srcSet":"/static/71a6a0ae20616d60ccf3ee5e19074125/be4d9/CI.png 192w,\n/static/71a6a0ae20616d60ccf3ee5e19074125/5fc50/CI.png 384w,\n/static/71a6a0ae20616d60ccf3ee5e19074125/473b7/CI.png 768w,\n/static/71a6a0ae20616d60ccf3ee5e19074125/13e83/CI.png 1536w","sizes":"(min-width: 768px) 768px, 100vw"},"sources":[{"srcSet":"/static/71a6a0ae20616d60ccf3ee5e19074125/b3234/CI.webp 192w,\n/static/71a6a0ae20616d60ccf3ee5e19074125/65a7c/CI.webp 384w,\n/static/71a6a0ae20616d60ccf3ee5e19074125/30053/CI.webp 768w,\n/static/71a6a0ae20616d60ccf3ee5e19074125/87027/CI.webp 1536w","type":"image/webp","sizes":"(min-width: 768px) 768px, 100vw"}]},"width":768,"height":400}}}}}}]},"siteStats":{"available":true,"posts":[{"path":"/web-bluetooth-api-guide/","views":1}]}},"pageContext":{"slug":"/vercel/","relatedSlugs":["/jamstack/","/web-deployment-architecture/","/spa-vs-mpa/","/pwa-implementation/"]}},"staticQueryHashes":["766300711"],"slicesMap":{}}