-caching-deep-dive.png 192w,\n/static/ce072e691a6300f099856265139a6b29/5fc50/service-worker-caching-deep-dive.png 384w,\n/static/ce072e691a6300f099856265139a6b29/473b7/service-worker-caching-deep-dive.png 768w,\n/static/ce072e691a6300f099856265139a6b29/13e83/service-worker-caching-deep-dive.png 1536w","sizes":"(min-width: 768px) 768px, 100vw"},"sources":[{"srcSet":"/static/ce072e691a6300f099856265139a6b29/b3234/service-worker-caching-deep-dive.webp 192w,\n/static/ce072e691a6300f099856265139a6b29/65a7c/service-worker-caching-deep-dive.webp 384w,\n/static/ce072e691a6300f099856265139a6b29/30053/service-worker-caching-deep-dive.webp 768w,\n/static/ce072e691a6300f099856265139a6b29/87027/service-worker-caching-deep-dive.webp 1536w","type":"image/webp","sizes":"(min-width: 768px) 768px, 100vw"}]},"width":768,"height":400}}}}}}]},"siteStats":{"available":true,"posts":[{"path":"/web-bluetooth-api-guide/","views":1}]}},"pageContext":{"slug":"/nextjs-isr-edge-caching/","relatedSlugs":["/nextjs/","/service-worker-caching-deep-dive/","/2026_web_trend (1)/","/2026_web_trend/"]}},"staticQueryHashes":["766300711"],"slicesMap":{}}