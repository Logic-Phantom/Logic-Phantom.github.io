llback":"data:image/png;base64,"},"images":{"fallback":{"src":"/static/a61771e37ca65a0952605023f367d460/473b7/HtmlStory.png","srcSet":"/static/a61771e37ca65a0952605023f367d460/be4d9/HtmlStory.png 192w,\n/static/a61771e37ca65a0952605023f367d460/5fc50/HtmlStory.png 384w,\n/static/a61771e37ca65a0952605023f367d460/473b7/HtmlStory.png 768w","sizes":"(min-width: 768px) 768px, 100vw"},"sources":[{"srcSet":"/static/a61771e37ca65a0952605023f367d460/b3234/HtmlStory.webp 192w,\n/static/a61771e37ca65a0952605023f367d460/65a7c/HtmlStory.webp 384w,\n/static/a61771e37ca65a0952605023f367d460/30053/HtmlStory.webp 768w","type":"image/webp","sizes":"(min-width: 768px) 768px, 100vw"}]},"width":768,"height":400}}}}}},{"node":{"id":"04b03588-68f6-52db-81cc-a42ba2d2109f","fields":{"slug":"/javascript-intl-api-i18n-guide/"},"frontmatter":{"title":"🌍 국제화(i18n)와 JavaScript Intl API 완벽 가이드","summary":"무거운 번들 없이 브라우저 내장 API로 끝내는 완벽한 웹 국제화","date":"2026.10.09.","categories":["Web","JavaScript"],"thumbnail":{"childImageSharp":{"gatsbyImageData":{"layout":"constrained","placeholder":{"fallback":"data:image/png;base64,"},"images":{"fallback":{"src":"/static/1f220406639f36bb2eeea3e9dcdeb178/473b7/javascript-intl-api-i18n-guide.png","srcSet":"/static/1f220406639f36bb2eeea3e9dcdeb178/be4d9/javascript-intl-api-i18n-guide.png 192w,\n/static/1f220406639f36bb2eeea3e9dcdeb178/5fc50/javascript-intl-api-i18n-guide.png 384w,\n/static/1f220406639f36bb2eeea3e9dcdeb178/473b7/javascript-intl-api-i18n-guide.png 768w,\n/static/1f220406639f36bb2eeea3e9dcdeb178/13e83/javascript-intl-api-i18n-guide.png 1536w","sizes":"(min-width: 768px) 768px, 100vw"},"sources":[{"srcSet":"/static/1f220406639f36bb2eeea3e9dcdeb178/b3234/javascript-intl-api-i18n-guide.webp 192w,\n/static/1f220406639f36bb2eeea3e9dcdeb178/65a7c/javascript-intl-api-i18n-guide.webp 384w,\n/static/1f220406639f36bb2eeea3e9dcdeb178/30053/javascript-intl-api-i18n-guide.webp 768w,\n/static/1f220406639f36bb2eeea3e9dcdeb178/87027/javascript-intl-api-i18n-guide.webp 1536w","type":"image/webp","sizes":"(min-width: 768px) 768px, 100vw"}]},"width":768,"height":400}}}}}},{"node":{"id":"47911708-3283-5c47-b0d9-71b6e0606611","fields":{"slug":"/js-modern-techniques-and-architecture/"},"frontmatter":{"title":"자바스크립트로 만드는 진짜 서비스","summary":"고급 기술과 아키텍처 이야기","date":"2025.07.25.","categories":["JavaScript","Web"],"thumbnail":{"childImageSharp":{"gatsbyImageData":{"layout":"constrained","placeholder":{"fallback":"data:image/png;base64,"},"images":{"fallback":{"src":"/static/6c274967b931bb7b98522ffd85842ad3/473b7/JavaScript.png","srcSet":"/static/6c274967b931bb7b98522ffd85842ad3/be4d9/JavaScript.png 192w,\n/static/6c274967b931bb7b98522ffd85842ad3/5fc50/JavaScript.png 384w,\n/static/6c274967b931bb7b98522ffd85842ad3/473b7/JavaScript.png 768w,\n/static/6c274967b931bb7b98522ffd85842ad3/13e83/JavaScript.png 1536w","sizes":"(min-width: 768px) 768px, 100vw"},"sources":[{"srcSet":"/static/6c274967b931bb7b98522ffd85842ad3/b3234/JavaScript.webp 192w,\n/static/6c274967b931bb7b98522ffd85842ad3/65a7c/JavaScript.webp 384w,\n/static/6c274967b931bb7b98522ffd85842ad3/30053/JavaScript.webp 768w,\n/static/6c274967b931bb7b98522ffd85842ad3/87027/JavaScript.webp 1536w","type":"image/webp","sizes":"(min-width: 768px) 768px, 100vw"}]},"width":768,"height":400}}}}}}]},"siteStats":{"available":true,"posts":[{"path":"/navigation-api-spa-routing-guide/","views":4},{"path":"/compute-pressure-api-guide/","views":3},{"path":"/gatsby/","views":3},{"path":"/popover-api-and-top-layer-guide/","views":3},{"path":"/web-identity-credential-manager-api-guide/","views":2},{"path":"/cloud-tech-overview/","views":1},{"path":"/frontend-observability-opentelemetry-rum/","views":1},{"path":"/islands-architecture-astro-guide/","views":1},{"path":"/prioritized-task-scheduling-posttask-guide/","views":1},{"path":"/supabase_guide/","views":1},{"path":"/vercel/","views":1},{"path":"/view-transitions-api-guide/","views":1},{"path":"/web-audio-api-guide/","views":1},{"path":"/web-bluetooth-and-hid-api-guide/","views":1},{"path":"/web-bluetooth-api-guide/","views":1},{"path":"/web-locks-api-concurrency-control/","views":1},{"path":"/web-share-target-api-guide/","views":1},{"path":"/webcodecs-api-guide/","views":1}]}},"pageContext":{"slug":"/how-js-works-after-html-loaded/","relatedSlugs":["/html-rendering-story/","/async-clipboard-api-guide/","/javascript-intl-api-i18n-guide/","/js-modern-techniques-and-architecture/"]}},"staticQueryHashes":["766300711"],"slicesMap":{}}