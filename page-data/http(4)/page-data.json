64,"},"images":{"fallback":{"src":"/static/249b113896c47d57a0a7b0bcb7010855/473b7/httpStatus.png","srcSet":"/static/249b113896c47d57a0a7b0bcb7010855/be4d9/httpStatus.png 192w,\n/static/249b113896c47d57a0a7b0bcb7010855/5fc50/httpStatus.png 384w,\n/static/249b113896c47d57a0a7b0bcb7010855/473b7/httpStatus.png 768w","sizes":"(min-width: 768px) 768px, 100vw"},"sources":[{"srcSet":"/static/249b113896c47d57a0a7b0bcb7010855/b3234/httpStatus.webp 192w,\n/static/249b113896c47d57a0a7b0bcb7010855/65a7c/httpStatus.webp 384w,\n/static/249b113896c47d57a0a7b0bcb7010855/30053/httpStatus.webp 768w","type":"image/webp","sizes":"(min-width: 768px) 768px, 100vw"}]},"width":768,"height":400}}}}}}]},"siteStats":{"available":true,"posts":[{"path":"/navigation-api-spa-routing-guide/","views":4},{"path":"/gatsby/","views":3},{"path":"/popover-api-and-top-layer-guide/","views":3},{"path":"/compute-pressure-api-guide/","views":2},{"path":"/web-identity-credential-manager-api-guide/","views":2},{"path":"/cloud-tech-overview/","views":1},{"path":"/frontend-observability-opentelemetry-rum/","views":1},{"path":"/islands-architecture-astro-guide/","views":1},{"path":"/prioritized-task-scheduling-posttask-guide/","views":1},{"path":"/supabase_guide/","views":1},{"path":"/vercel/","views":1},{"path":"/view-transitions-api-guide/","views":1},{"path":"/web-audio-api-guide/","views":1},{"path":"/web-bluetooth-and-hid-api-guide/","views":1},{"path":"/web-bluetooth-api-guide/","views":1},{"path":"/web-locks-api-concurrency-control/","views":1},{"path":"/web-share-target-api-guide/","views":1},{"path":"/webcodecs-api-guide/","views":1}]}},"pageContext":{"slug":"/http(4)/","relatedSlugs":["/http(3)/","/http_status_codes/","/http(2)/","/http/"]}},"staticQueryHashes":["766300711"],"slicesMap":{}}