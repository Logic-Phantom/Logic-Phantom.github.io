cSet":"/static/7615d63598c2109386a1ad1b2e4dec27/b3234/compression-streams-api-guide.webp 192w,\n/static/7615d63598c2109386a1ad1b2e4dec27/65a7c/compression-streams-api-guide.webp 384w,\n/static/7615d63598c2109386a1ad1b2e4dec27/30053/compression-streams-api-guide.webp 768w,\n/static/7615d63598c2109386a1ad1b2e4dec27/87027/compression-streams-api-guide.webp 1536w","type":"image/webp","sizes":"(min-width: 768px) 768px, 100vw"}]},"width":768,"height":400}}}}}},{"node":{"id":"bdf52782-38cd-52f7-875c-1a06ded48c0f","fields":{"slug":"/vo-vs-dto-guide/"},"frontmatter":{"title":"VO와 DTO 개념 심층 가이드","summary":"데이터 구조 정의 및 전달 방식","date":"2025.09.02.","categories":["Web","Server"],"thumbnail":{"childImageSharp":{"gatsbyImageData":{"layout":"constrained","placeholder":{"fallback":"data:image/png;base64,"},"images":{"fallback":{"src":"/static/2c177f90f763961c7e0b9ab7f8f09e47/473b7/voDto.png","srcSet":"/static/2c177f90f763961c7e0b9ab7f8f09e47/be4d9/voDto.png 192w,\n/static/2c177f90f763961c7e0b9ab7f8f09e47/5fc50/voDto.png 384w,\n/static/2c177f90f763961c7e0b9ab7f8f09e47/473b7/voDto.png 768w,\n/static/2c177f90f763961c7e0b9ab7f8f09e47/13e83/voDto.png 1536w","sizes":"(min-width: 768px) 768px, 100vw"},"sources":[{"srcSet":"/static/2c177f90f763961c7e0b9ab7f8f09e47/b3234/voDto.webp 192w,\n/static/2c177f90f763961c7e0b9ab7f8f09e47/65a7c/voDto.webp 384w,\n/static/2c177f90f763961c7e0b9ab7f8f09e47/30053/voDto.webp 768w,\n/static/2c177f90f763961c7e0b9ab7f8f09e47/87027/voDto.webp 1536w","type":"image/webp","sizes":"(min-width: 768px) 768px, 100vw"}]},"width":768,"height":400}}}}}},{"node":{"id":"6284d669-00ba-58b0-8c42-a823f87b3541","fields":{"slug":"/web-locks-api-concurrency-control/"},"frontmatter":{"title":"🔒 Web Locks API 완벽 가이드: 브라우저 다중 탭 동시성 제어와 리더 선출","summary":"탭이 10개 열려도 데이터 꼬임 없는 브라우저 락","date":"2026.10.17.","categories":["Web"],"thumbnail":{"childImageSharp":{"gatsbyImageData":{"layout":"constrained","placeholder":{"fallback":"data:image/png;base64,"},"images":{"fallback":{"src":"/static/77d3533f77052c140bf796fc9c859f68/473b7/web-locks-api-concurrency-control.png","srcSet":"/static/77d3533f77052c140bf796fc9c859f68/be4d9/web-locks-api-concurrency-control.png 192w,\n/static/77d3533f77052c140bf796fc9c859f68/5fc50/web-locks-api-concurrency-control.png 384w,\n/static/77d3533f77052c140bf796fc9c859f68/473b7/web-locks-api-concurrency-control.png 768w,\n/static/77d3533f77052c140bf796fc9c859f68/13e83/web-locks-api-concurrency-control.png 1536w","sizes":"(min-width: 768px) 768px, 100vw"},"sources":[{"srcSet":"/static/77d3533f77052c140bf796fc9c859f68/b3234/web-locks-api-concurrency-control.webp 192w,\n/static/77d3533f77052c140bf796fc9c859f68/65a7c/web-locks-api-concurrency-control.webp 384w,\n/static/77d3533f77052c140bf796fc9c859f68/30053/web-locks-api-concurrency-control.webp 768w,\n/static/77d3533f77052c140bf796fc9c859f68/87027/web-locks-api-concurrency-control.webp 1536w","type":"image/webp","sizes":"(min-width: 768px) 768px, 100vw"}]},"width":768,"height":400}}}}}}]},"siteStats":{"available":true,"posts":[{"path":"/navigation-api-spa-routing-guide/","views":4},{"path":"/compute-pressure-api-guide/","views":3},{"path":"/gatsby/","views":3},{"path":"/popover-api-and-top-layer-guide/","views":3},{"path":"/web-identity-credential-manager-api-guide/","views":2},{"path":"/cloud-tech-overview/","views":1},{"path":"/frontend-observability-opentelemetry-rum/","views":1},{"path":"/islands-architecture-astro-guide/","views":1},{"path":"/prioritized-task-scheduling-posttask-guide/","views":1},{"path":"/supabase_guide/","views":1},{"path":"/vercel/","views":1},{"path":"/view-transitions-api-guide/","views":1},{"path":"/web-audio-api-guide/","views":1},{"path":"/web-bluetooth-and-hid-api-guide/","views":1},{"path":"/web-bluetooth-api-guide/","views":1},{"path":"/web-locks-api-concurrency-control/","views":1},{"path":"/web-share-target-api-guide/","views":1},{"path":"/webcodecs-api-guide/","views":1}]}},"pageContext":{"slug":"/json_unstructured_data/","relatedSlugs":["/w