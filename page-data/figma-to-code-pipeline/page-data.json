p","sizes":"(min-width: 768px) 768px, 100vw"}]},"width":768,"height":400}}}}}},{"node":{"id":"74648c70-8c5b-5642-883f-415017c8b639","fields":{"slug":"/vibe-coding/"},"frontmatter":{"title":"Vibe Coding: 개발 생산성 향상 도구","summary":"Vibe Coding을 활용한 개발 워크플로우 최적화","date":"2024.11.20.","categories":["Developer Tool"],"thumbnail":{"childImageSharp":{"gatsbyImageData":{"layout":"constrained","placeholder":{"fallback":"data:image/png;base64,"},"images":{"fallback":{"src":"/static/5132b89ae42fe9097f5a4ed126ed18d4/473b7/vibe-coding2.png","srcSet":"/static/5132b89ae42fe9097f5a4ed126ed18d4/be4d9/vibe-coding2.png 192w,\n/static/5132b89ae42fe9097f5a4ed126ed18d4/5fc50/vibe-coding2.png 384w,\n/static/5132b89ae42fe9097f5a4ed126ed18d4/473b7/vibe-coding2.png 768w","sizes":"(min-width: 768px) 768px, 100vw"},"sources":[{"srcSet":"/static/5132b89ae42fe9097f5a4ed126ed18d4/b3234/vibe-coding2.webp 192w,\n/static/5132b89ae42fe9097f5a4ed126ed18d4/65a7c/vibe-coding2.webp 384w,\n/static/5132b89ae42fe9097f5a4ed126ed18d4/30053/vibe-coding2.webp 768w","type":"image/webp","sizes":"(min-width: 768px) 768px, 100vw"}]},"width":768,"height":400}}}}}},{"node":{"id":"2b59d5a0-5d38-5584-84ec-22a839f82b8e","fields":{"slug":"/web-identity-credential-manager-api-guide/"},"frontmatter":{"title":"🪪 Credential Management API 완벽 가이드","summary":"비밀번호 없는 차세대 웹 로그인","date":"2026.10.22.","categories":["Web"],"thumbnail":{"childImageSharp":{"gatsbyImageData":{"layout":"constrained","placeholder":{"fallback":"data:image/png;base64,"},"images":{"fallback":{"src":"/static/8b5abf281bb69bcd306c30abcba1e494/473b7/web-identity-credential-manager-api-guide.png","srcSet":"/static/8b5abf281bb69bcd306c30abcba1e494/be4d9/web-identity-credential-manager-api-guide.png 192w,\n/static/8b5abf281bb69bcd306c30abcba1e494/5fc50/web-identity-credential-manager-api-guide.png 384w,\n/static/8b5abf281bb69bcd306c30abcba1e494/473b7/web-identity-credential-manager-api-guide.png 768w,\n/static/8b5abf281bb69bcd306c30abcba1e494/13e83/web-identity-cr