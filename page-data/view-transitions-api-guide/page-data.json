-layer-guide/","views":2},{"path":"/cloud-tech-overview/","views":1},{"path":"/frontend-observability-opentelemetry-rum/","views":1},{"path":"/islands-architecture-astro-guide/","views":1},{"path":"/supabase_guide/","views":1},{"path":"/vercel/","views":1},{"path":"/view-transitions-api-guide/","views":1},{"path":"/web-audio-api-guide/","views":1},{"path":"/web-bluetooth-and-hid-api-guide/","views":1},{"path":"/web-bluetooth-api-guide/","views":1},{"path":"/web-identity-credential-manager-api-guide/","views":1},{"path":"/web-locks-api-concurrency-control/","views":1},{"path":"/webcodecs-api-guide/","views":1}]}},"pageContext":{"slug":"/view-transitions-api-guide/","relatedSlugs":["/broadcast-channel-api-cross-tab-communication/","/javascript-intl-api-i18n-guide/","/sqlite-in-the-browser-wasm/","/javascript_async_closure/"]}},"staticQueryHashes":["766300711"],"slicesMap":{}}