-guide/","views":1},{"path":"/supabase_guide/","views":1},{"path":"/vercel/","views":1},{"path":"/view-transitions-api-guide/","views":1},{"path":"/web-audio-api-guide/","views":1},{"path":"/web-bluetooth-and-hid-api-guide/","views":1},{"path":"/web-bluetooth-api-guide/","views":1},{"path":"/web-locks-api-concurrency-control/","views":1},{"path":"/web-share-target-api-guide/","views":1},{"path":"/webcodecs-api-guide/","views":1}]}},"pageContext":{"slug":"/ai-code-assistant-guide/","relatedSlugs":["/ai-coding-assistants/","/ai_editors_tools/","/ai-era-fe-be-what-to-prepare-2025/","/ai-governance/"]}},"staticQueryHashes":["766300711"],"slicesMap":{}}