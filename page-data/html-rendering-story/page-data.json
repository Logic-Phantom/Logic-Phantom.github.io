":"🖥️ 브라우저가 HTML을 불러온 뒤, JavaScript는 무슨 일을 할까?","summary":"JavaScript의 기나긴 여정","date":"2025.07.14.","categories":["Web","Html","JavaScript"],"thumbnail":{"childImageSharp":{"gatsbyImageData":{"layout":"constrained","placeholder":{"fallback":"data:image/png;base64,"},"images":{"fallback":{"src":"/static/49785b0f4b2fb477759995eb1f6533d8/473b7/JavaScriptStory.png","srcSet":"/static/49785b0f4b2fb477759995eb1f6533d8/be4d9/JavaScriptStory.png 192w,\n/static/49785b0f4b2fb477759995eb1f6533d8/5fc50/JavaScriptStory.png 384w,\n/static/49785b0f4b2fb477759995eb1f6533d8/473b7/JavaScriptStory.png 768w","sizes":"(min-width: 768px) 768px, 100vw"},"sources":[{"srcSet":"/static/49785b0f4b2fb477759995eb1f6533d8/b3234/JavaScriptStory.webp 192w,\n/static/49785b0f4b2fb477759995eb1f6533d8/65a7c/JavaScriptStory.webp 384w,\n/static/49785b0f4b2fb477759995eb1f6533d8/30053/JavaScriptStory.webp 768w","type":"image/webp","sizes":"(min-width: 768px) 768px, 100vw"}]},"width":768,"height":400}}}}}},{"node":{"id":"eadab37e-dfb8-50d2-9397-97f9f335f603","fields":{"slug":"/spring-dispatcher-servlet-story/"},"frontmatter":{"title":"🧵 Spring MVC 이야기","summary":"DispatcherServlet이 들려주는 웹 요청 여정","date":"2025.07.07.","categories":["Web"],"thumbnail":{"childImageSharp":{"gatsbyImageData":{"layout":"constrained","placeholder":{"fallback":"data:image/png;base64,"},"images":{"fallback":{"src":"/static/5f0bb591da93d20e26cf06cb1ebe8e4e/473b7/SpringMVC.png","srcSet":"/static/5f0bb591da93d20e26cf06cb1ebe8e4e/be4d9/SpringMVC.png 192w,\n/static/5f0bb591da93d20e26cf06cb1ebe8e4e/5fc50/SpringMVC.png 384w,\n/static/5f0bb591da93d20e26cf06cb1ebe8e4e/473b7/SpringMVC.png 768w,\n/static/5f0bb591da93d20e26cf06cb1ebe8e4e/13e83/SpringMVC.png 1536w","sizes":"(min-width: 768px) 768px, 100vw"},"sources":[{"srcSet":"/static/5f0bb591da93d20e26cf06cb1ebe8e4e/b3234/SpringMVC.webp 192w,\n/static/5f0bb591da93d20e26cf06cb1ebe8e4e/65a7c/SpringMVC.webp 384w,\n/static/5f0bb591da93d20e26cf06cb1ebe8e4e/30053/SpringMVC.webp 768w,\n/static/5f0bb591da93d20e26cf06cb1ebe8e4e/87027/SpringMVC.webp 1536w","type":"image/webp","sizes":"(min-width: 768px) 768px, 100vw"}]},"width":768,"height":400}}}}}}]},"siteStats":{"available":true,"posts":[{"path":"/navigation-api-spa-routing-guide/","views":4},{"path":"/compute-pressure-api-guide/","views":3},{"path":"/gatsby/","views":3},{"path":"/popover-api-and-top-layer-guide/","views":3},{"path":"/web-identity-credential-manager-api-guide/","views":2},{"path":"/cloud-tech-overview/","views":1},{"path":"/frontend-observability-opentelemetry-rum/","views":1},{"path":"/islands-architecture-astro-guide/","views":1},{"path":"/prioritized-task-scheduling-posttask-guide/","views":1},{"path":"/supabase_guide/","views":1},{"path":"/vercel/","views":1},{"path":"/view-transitions-api-guide/","views":1},{"path":"/web-audio-api-guide/","views":1},{"path":"/web-bluetooth-and-hid-api-guide/","views":1},{"path":"/web-bluetooth-api-guide/","views":1},{"path":"/web-locks-api-concurrency-control/","views":1},{"path":"/web-share-target-api-guide/","views":1},{"path":"/webcodecs-api-guide/","views":1}]}},"pageContext":{"slug":"/html-rendering-story/","relatedSlugs":["/how-js-works-after-html-loaded/","/browser-autoplay-policy/","/spring-dispatcher-servlet-story/","/file-system-access-api-guide/"]}},"staticQueryHashes":["766300711"],"slicesMap":{}}