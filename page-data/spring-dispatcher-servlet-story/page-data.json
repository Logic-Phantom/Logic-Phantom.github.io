548/65a7c/jsRule2.webp 384w,\n/static/a2f0854f144f881dd78a3d707c426548/30053/jsRule2.webp 768w","type":"image/webp","sizes":"(min-width: 768px) 768px, 100vw"}]},"width":768,"height":400}}}}}},{"node":{"id":"47911708-3283-5c47-b0d9-71b6e0606611","fields":{"slug":"/js-modern-techniques-and-architecture/"},"frontmatter":{"title":"자바스크립트로 만드는 진짜 서비스","summary":"고급 기술과 아키텍처 이야기","date":"2025.07.25.","categories":["JavaScript","Web"],"thumbnail":{"childImageSharp":{"gatsbyImageData":{"layout":"constrained","placeholder":{"fallback":"data:image/png;base64,"},"images":{"fallback":{"src":"/static/6c274967b931bb7b98522ffd85842ad3/473b7/JavaScript.png","srcSet":"/static/6c274967b931bb7b98522ffd85842ad3/be4d9/JavaScript.png 192w,\n/static/6c274967b931bb7b98522ffd85842ad3/5fc50/JavaScript.png 384w,\n/static/6c274967b931bb7b98522ffd85842ad3/473b7/JavaScript.png 768w,\n/static/6c274967b931bb7b98522ffd85842ad3/13e83/JavaScript.png 1536w","sizes":"(min-width: 768px) 768px, 100vw"},"sources":[{"srcSet":"/static/6c274967b931bb7b98522ffd85842ad3/b3234/JavaScript.webp 192w,\n/static/6c274967b931bb7b98522ffd85842ad3/65a7c/JavaScript.webp 384w,\n/static/6c274967b931bb7b98522ffd85842ad3/30053/JavaScript.webp 768w,\n/static/6c274967b931bb7b98522ffd85842ad3/87027/JavaScript.webp 1536w","type":"image/webp","sizes":"(min-width: 768px) 768px, 100vw"}]},"width":768,"height":400}}}}}}]},"siteStats":{"available":false,"posts":[]}},"pageContext":{"slug":"/spring-dispatcher-servlet-story/","relatedSlugs":["/javascript_async_closure/","/js-modern-techniques-and-architecture/","/how-js-works-after-html-loaded/","/html-rendering-story/"]}},"staticQueryHashes":["766300711"],"slicesMap":{}}