:"(min-width: 768px) 768px, 100vw"},"sources":[{"srcSet":"/static/188d5311f7570bc06a3c9d4e610238a9/b3234/Polices.webp 192w,\n/static/188d5311f7570bc06a3c9d4e610238a9/65a7c/Polices.webp 384w,\n/static/188d5311f7570bc06a3c9d4e610238a9/30053/Polices.webp 768w,\n/static/188d5311f7570bc06a3c9d4e610238a9/87027/Polices.webp 1536w","type":"image/webp","sizes":"(min-width: 768px) 768px, 100vw"}]},"width":768,"height":400}}}}}}]},"siteStats":{"available":true,"posts":[{"path":"/navigation-api-spa-routing-guide/","views":4},{"path":"/gatsby/","views":3},{"path":"/compute-pressure-api-guide/","views":2},{"path":"/popover-api-and-top-layer-guide/","views":2},{"path":"/web-identity-credential-manager-api-guide/","views":2},{"path":"/cloud-tech-overview/","views":1},{"path":"/frontend-observability-opentelemetry-rum/","views":1},{"path":"/islands-architecture-astro-guide/","views":1},{"path":"/supabase_guide/","views":1},{"path":"/vercel/","views":1},{"path":"/view-transitions-api-guide/","views":1},{"path":"/web-audio-api-guide/","views":1},{"path":"/web-bluetooth-and-hid-api-guide/","views":1},{"path":"/web-bluetooth-api-guide/","views":1},{"path":"/web-locks-api-concurrency-control/","views":1},{"path":"/web-share-target-api-guide/","views":1},{"path":"/webcodecs-api-guide/","views":1}]}},"pageContext":{"slug":"/web_tips/","relatedSlugs":["/2026-web-trends/","/Monolith/","/web_security_policies/","/html-web-standards-guide/"]}},"staticQueryHashes":["766300711"],"slicesMap":{}}